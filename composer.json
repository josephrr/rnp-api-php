{
    "name": "egobytes/rnp-api",
    "description": "Cliente PHP del API de consulta vehicular del Registro Nacional de Costa Rica.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "costa-rica",
        "registro-nacional",
        "vehiculos",
        "placa",
        "vin",
        "api"
    ],
    "homepage": "https://rnp.egobytes.com/docs",
    "authors": [
        {
            "name": "Egobytes",
            "email": "soporte@egobytes.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Egobytes\\Rnp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Egobytes\\Rnp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "support": {
        "issues": "https://github.com/egobytes/rnp-api-php/issues",
        "source": "https://github.com/egobytes/rnp-api-php",
        "docs": "https://rnp.egobytes.com/docs",
        "email": "soporte@egobytes.com"
    }
}